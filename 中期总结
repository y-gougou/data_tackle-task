### 5.5 推理节点设计

```python
# inference_node.py
class FaultDiagnosisNode:
    def __init__(self):
        # 加载模型
        self.model = torch.load('fault_diagnosis_model.pth')
        self.model.eval()

        # 环形缓冲区 (5秒 @ 20Hz = 100点)
        self.buffer = RingBuffer(shape=(100, 16))

        # 加载归一化参数
        with open('norm_params.pkl', 'rb') as f:
            self.norm_params = pickle.load(f)

        # 订阅话题
        rospy.Subscriber('/odom', Odometry, self.odom_callback)
        rospy.Subscriber('/imu', Imu, self.imu_callback)
        rospy.Subscriber('/current_data', Float32MultiArray, self.current_callback)

        # 发布诊断结果
        self.diag_pub = rospy.Publisher('/diagnosis/result', String, queue_size=10)

    def diagnose(self):
        """执行一次诊断"""
        if len(self.buffer) < 100:
            return

        # 构建窗口
        window = self.buffer.get_last(100)

        # 归一化
        window = self.normalize(window)

        # 转换为tensor
        window_tensor = torch.tensor(window, dtype=torch.float32).unsqueeze(0)

        # 推理
        with torch.no_grad():
            output = self.model(window_tensor)
            probs = torch.softmax(output, dim=1)[0]
            pred = torch.argmax(probs).item()
            confidence = probs[pred].item()

        # 发布结果
        result = {
            'fault_type': pred,
            'fault_name': LABEL_NAMES[pred],
            'confidence': confidence,
            'all_probabilities': probs.tolist(),
            'timestamp': rospy.Time.now().to_sec()
        }
        self.diag_pub.publish(json.dumps(result))
